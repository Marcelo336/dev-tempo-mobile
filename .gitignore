# Dependency directories
node_modules/

# Environment variables
.env                # Ignore the main .env file (CRITICAL!)
.env*.local         # Ignore specific local environment files

# Expo / React Native specific ignores
.expo/              # Expo cache directory
dist/               # Build output for web/standalone apps
web-build/          # Web build output
/ios                # Generated iOS project folder
/android            # Generated Android project folder
*.jks               # Java Keystore (Android signing)
*.p8                # Apple Developer key
*.p12               # Apple Developer certificate
*.key               # Generic private key
*.mobileprovision   # Apple iOS provisioning profile
*.pem               # Private key certificates (can be used for various things)
.kotlin/            # Kotlin specific build files, if any

# VS Code
.vscode/settings.json # Personal VS Code workspace settings

# Temporary / Build artifacts
*.orig.*            # Backup files
.metro-health-check* # Metro bundler health check files
npm-debug.*         # npm debug logs
yarn-debug.*        # Yarn debug logs
yarn-error.*        # Yarn error logs
*.tsbuildinfo       # TypeScript build cache

# macOS specific
.DS_Store           # macOS folder metadata

# Unused template files (as discussed earlier)
AGENTS.md
LICENSE